{
  "name": "quickcart",
  "version": "1.0.0",
  "description": "QuickCart Merchant API - Realistic Quick-Commerce Backend & Console",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "console"
  ],
  "scripts": {
    "dev": "npm --prefix server run dev",
    "build:server": "npm --prefix server run build",
    "build:console": "npm --prefix console run build",
    "build": "npm run build:console && npm run build:server",
    "start": "node server/dist/server.js",
    "test": "npm --prefix server run test",
    "lint": "npm --prefix server run lint",
    "seed:check": "npm --prefix server run seed:check"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

