# QuickCart Merchant API Environment Variables
PORT=4000
NODE_ENV=development
ADMIN_KEY=replace_with_admin_secret_key
DEV_TOOLS=true

# Semicolon-delimited tokens in format: name:token:scopes
# Supported scopes: catalog:read, cart:write, checkout:create, orders:read
AGENT_TOKENS=default_agent:replace_with_agent_bearer_token:catalog:read,cart:write,checkout:create,orders:read;readonly_agent:replace_with_readonly_token:catalog:read,orders:read

# Razorpay Test Mode Credentials (placeholders trigger in-memory fake client)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Payment session HMAC signing secret (minimum 16 characters)
SESSION_SIGNING_SECRET=replace_with_secure_signing_secret_min_32_chars

# Public Base URL for CORS and links
PUBLIC_BASE_URL=http://localhost:4000
